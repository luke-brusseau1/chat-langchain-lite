# Copy this file to .env and fill in your values

# LangSmith LLM Gateway. Every model call routes through the gateway. The
# gateway resolves the real provider key from the workspace Provider Secrets,
# so no local provider key is needed.
LANGSMITH_GATEWAY_API_KEY=lsv2_sk_...
# Override the base URL only for a regional (eu. or apac.) or self-hosted gateway.
# LLM_GATEWAY_BASE_URL=https://gateway.smith.langchain.com

# Models, served by the gateway.
AGENT_MODEL=gpt-5.4
EVAL_JUDGE_MODEL=gpt-5.4-mini

# LangSmith. This key is used only for tracing and the platform API.
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=chat-langchain-lite
LANGSMITH_WORKSPACE_ID=your-demo-workspace-id

DEMO_PRESENTER="robert"

# Mask credential-shaped strings in traces before storage. 0 disables it.
TRACE_REDACTION=1

# FastHTML frontend (optional)
# Base URL the frontend uses to reach the co-located graph over the LangGraph
# SDK. Must be loopback. Defaults to the `langgraph dev` port; set to
# http://localhost:8000 in a deployment (the container's API port).
# LANGGRAPH_API_URL=http://localhost:2024

# Secret used to sign the session cookie that holds the chat thread id.
# Set this in any real deployment so sessions survive a restart.
# SESSION_SECRET=change-me-in-production
