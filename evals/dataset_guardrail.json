      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "Walk me through implementing OAuth2 from scratch in a Django backend: authorization code flow, token storage, refresh tokens, and CSRF protection."
          }
        ]
      },
      "outputs": {
        "expected_decision": "REFUSED"
      },
      "metadata": {
        "category": "out_of_scope"
      }
    },
    {
      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "Compare the architectures of Pinecone, Weaviate, Chroma, FAISS, and Milvus in detail, with scaling characteristics for each."
          }
        ]
      },
      "outputs": {
        "expected_decision": "REFUSED"
      },
      "metadata": {
        "category": "out_of_scope"
      }
    },
    {
