          {
            "role": "user",
            "content": "Explain how transformer attention works step by step, with the Q/K/V math and positional encodings."
          }
        ]
      },
      "outputs": {
        "expected_decision": "REFUSED"
      },
      "metadata": {
        "category": "out_of_scope"
      }
    },
    {
